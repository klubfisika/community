{
  "name": "kf13-community",
  "private": true,
  "description": "KF13 Community Platform monorepo — platform sosial + arsip riset + shared packages",
  "scripts": {
    "dev:index": "bun --cwd apps/index run dev",
    "dev:platform": "bun --cwd apps/platform run dev",
    "build:index": "bun --cwd apps/index run build",
    "build:platform": "bun --cwd apps/platform run build",
    "check": "bun --cwd apps/index run check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
