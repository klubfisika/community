{
  "name": "kf13-community",
  "private": true,
  "description": "KF13 Community Platform monorepo — platform sosial + arsip riset + shared packages",
  "scripts": {
    "dev:index": "bun run --cwd apps/index dev",
    "dev:platform": "bun run --cwd apps/platform dev",
    "build:index": "bun run --cwd apps/index build",
    "build:platform": "bun run --cwd apps/platform build",
    "check": "bun run --cwd apps/index check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
